PlusBtn.Font = Enum.Font.SourceSansBold
PlusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
PlusBtn.TextSize = 18
Instance.new("UICorner", PlusBtn).CornerRadius = UDim.new(0, 6)

-- TF26 Deep Ball Finder
local function findTF26Ball()
	for _, obj in pairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("MeshPart") then
			local name = obj.Name:lower()
			if name == "ball" or name == "football" or name == "soccerball" or name == "tp" or obj:FindFirstChild("BallScript") or obj:FindFirstChild("TouchInterest") then
				if not obj:IsDescendantOf(Players) then
					return obj
				end
			end
		end
	end
	return nil
end

-- Highlight Manager
local function applyBlueHighlight(ball)
	if not ball:FindFirstChild("TF26BlueHighlight") then
		local hl = Instance.new("Highlight")
		hl.Name = "TF26BlueHighlight"
		hl.Adornee = ball
		hl.FillColor = Color3.fromRGB(0, 140, 255)
		hl.FillTransparency = 0.5
		hl.OutlineColor = Color3.fromRGB(0, 230, 255)
		hl.OutlineTransparency = 0
		hl.Parent = ball
	end
end

local function removeBlueHighlight(ball)
	if ball and ball:FindFirstChild("TF26BlueHighlight") then
		ball.TF26BlueHighlight:Destroy()
	end
end

-- Realtime Loop
RunService.Heartbeat:Connect(function()
	ActiveBall = findTF26Ball()
	if ActiveBall then
		if HitboxEnabled then
			ActiveBall.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
			ActiveBall.CanCollide = false
			applyBlueHighlight(ActiveBall)
		else
			removeBlueHighlight(ActiveBall)
		end
	end
end)

-- UI Interactions
ToggleBtn.MouseButton1Click:Connect(function()
	HitboxEnabled = not HitboxEnabled
	if HitboxEnabled then
		ToggleBtn.Text = "Hitbox: ON"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
	else
		ToggleBtn.Text = "Hitbox: OFF"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		if ActiveBall then
			removeBlueHighlight(ActiveBall)
		end
	end
end)

PlusBtn.MouseButton1Click:Connect(function()
	HitboxSize = HitboxSize + 3
	SizeLabel.Text = "Hitbox Size: " .. tostring(HitboxSize)
end)

MinusBtn.MouseButton1Click:Connect(function()
	if HitboxSize > 3 then
		HitboxSize = HitboxSize - 3
		SizeLabel.Text = "Hitbox Size: " .. tostring(HitboxSize)
	end
end)
